# ZiffSplit SDK (optional — leave blank to disable banners)
# Local API: http://localhost:4100
# Production API: https://ziffsplit-api.fly.dev
VITE_AB_API_BASE=http://localhost:4100
# Site key from ZiffSplit Admin → brand → environment → Settings
VITE_AB_SITE_KEY=

# JiffContent CMS (optional — leave blank to use built-in homepage/navbar defaults)
# Public key from JiffContent Brand settings (MUST be jc_pk_... in browser).
VITE_JIFFCONTENT_PUBLIC_KEY=
# Optional custom API base (default: https://api.jiffcontent.com)
# VITE_JIFFCONTENT_API_BASE=https://api.jiffcontent.com
# Optional locale override for reads (e.g. en, es, pt-BR)
# VITE_JIFFCONTENT_LOCALE=en
# Published page path for the workspace homepage (default /)
# VITE_JIFFCONTENT_HOME_PATH=/

# Stamp ZiffSplit assignments onto Waypoint audit events (default: on when VITE_AB_SITE_KEY is set).
# VITE_EXPERIMENT_AUDIT_CONTEXT=true

# Build artifacts (the image rebuilds them in-stage).
# Do NOT use **/dist — that would also drop frontend/vendor/ziffsplit-sdk/dist,
# which must be present for npm ci / tsc during the frontend image build.
**/node_modules
frontend/dist
backend/dist
**/build
**/*.tsbuildinfo

# Local DB volume must never end up in the image.
postgres-data/

# VCS + IDE + OS cruft.
.git/
.gitignore
.github/
.idea/
.vscode/
.DS_Store

# Deploy manifests are for the cluster, not the container.
deploy/

# Never bake local secrets into the image.
**/.env
**/.env.*
!**/.env.example

# Docs live in the repo, not the image.
*.md
docs/
